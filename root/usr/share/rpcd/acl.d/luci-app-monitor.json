{
	"luci-app-monitor": {
		"description": "Grant read access to LuCI Monitor",
		"read": {
			"file": {
				"/proc/stat": [ "read" ],
				"/usr/sbin/sensors -j -A": [ "exec" ]
			},
			"ubus": {
				"file": [ "exec", "read" ],
				"luci-rpc": [ "getNetworkDevices" ],
				"network.interface": [ "dump" ],
				"system": [ "info" ]
			},
			"uci": [ "firewall", "network", "system" ]
		}
	}
}
